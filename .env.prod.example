# Copy to .env next to docker-compose.prod.yml and fill in.
# Start with: docker compose -f docker-compose.prod.yml up -d

# Image tag: "latest" (prod, main branch) or "test" (develop branch)
IMAGE_TAG=latest

# Public URLs (behind your reverse proxy)
BACKEND_URL=https://api.example.com
WEB_APP_URL=https://app.example.com

# Local ports the reverse proxy forwards to (bound to 127.0.0.1)
WEB_PORT=3000
API_PORT=8000

# Secrets — generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
INTERNAL_API_SECRET=
SESSION_SECRET=
JWT_SECRET=

# Deployment
DEPLOYMENT_MODE=self-hosted
LOG_LEVEL=INFO

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
