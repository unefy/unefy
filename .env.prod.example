# Copy to .env next to docker-compose.prod.yml and fill in.
# Start with: docker compose -f docker-compose.prod.yml up -d

# Image tag: "latest" (prod, main branch) or "test" (develop branch)
IMAGE_TAG=latest

# Public URLs (behind your reverse proxy)
BACKEND_URL=https://api.example.com
WEB_APP_URL=https://app.example.com

# Parent domain of both hosts above, with the leading dot. Required as soon as
# they differ: the magic link is redeemed on the API host and the session
# cookie has to be readable by the app host. Leave empty only when both run on
# one hostname.
#
# The backend refuses to start without it when the two hosts differ, and
# refuses a value that does not cover both. Booting instead would mean a stack
# that answers every request with 200, passes its health checks, and lets
# nobody sign in.
COOKIE_DOMAIN=.example.com

# Local ports the reverse proxy forwards to (bound to 127.0.0.1)
WEB_PORT=3000
API_PORT=8000

# Secrets — generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
INTERNAL_API_SECRET=
SESSION_SECRET=
JWT_SECRET=
# Rotating it invalidates every check-in code currently on a phone, so it has
# its own value rather than sharing JWT_SECRET.
ATTENDANCE_SECRET=

# Deployment
DEPLOYMENT_MODE=self-hosted
LOG_LEVEL=INFO

# Email. Not optional in practice: login codes, magic links and invitations
# all go out this way. Left empty the backend writes each message to the log
# instead — including the login code — and nobody but you gets in.
# Port 587 with STARTTLS; implicit TLS on 465 is not supported.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=unefy <noreply@example.com>
SMTP_STARTTLS=true

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extra client ids accepted by the mobile Google sign-in, as a JSON array.
# Only needed when members use the *published* unefy app against this server:
# the app's ID tokens carry its own client id, not yours.
# Leave it commented out when unused — an empty value is not valid JSON.
#GOOGLE_MOBILE_CLIENT_IDS=["123-abc.apps.googleusercontent.com"]
