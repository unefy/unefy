<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Test-only host for composables; never part of the shipped manifest.
             A platform theme, not Theme.Unefy: this activity lives in the test
             APK, which cannot resolve the app's resources. Colours come from
             UnefyTheme inside the composition anyway. -->
        <activity
            android:name="com.unefy.app.HiltTestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>

</manifest>
