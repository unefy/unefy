<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: permits cleartext HTTP to the local dev backend. Release builds
     inherit the platform default, which blocks cleartext entirely. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig">

        <!-- Host for composables under test. It lives in the debug variant
             rather than in androidTest because an activity declared in the test
             APK resolves to the com.unefy.app.test process, which
             Instrumentation refuses to start from com.unefy.app. -->
        <activity
            android:name="com.unefy.app.HiltTestActivity"
            android:exported="false"
            android:theme="@style/Theme.Unefy" />
    </application>
</manifest>
