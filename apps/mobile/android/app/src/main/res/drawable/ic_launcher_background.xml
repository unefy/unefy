<?xml version="1.0" encoding="utf-8"?>
<!--
  Hintergrundebene des Adaptive Icons: der Verlauf aus der Icon-Spezifikation
  (#101218 -> #1A1D40, 160 Grad). Viewport 100 statt der ueblichen 108, damit
  die Koordinaten eins zu eins denen der Quell-SVGs entsprechen; die Ebene
  fuellt ohnehin die gesamte 108er-Flaeche, die Zahl ist reine Skalierung.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path android:pathData="M0,0h100v100h-100z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="62"
                android:endY="100">
                <item
                    android:offset="0"
                    android:color="#101218" />
                <item
                    android:offset="1"
                    android:color="#1A1D40" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
