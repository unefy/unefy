# Database
# Port 5433, not 5432: that is what docker-compose.yml publishes, and 5432 on a
# developer machine is usually some other project's Postgres. Pointing here at
# 5432 does not fail loudly — alembic and the seed scripts simply talk to the
# wrong database.
DATABASE_URL=postgresql+asyncpg://unefy:unefy@localhost:5433/unefy

# Redis
REDIS_URL=redis://localhost:6379/0

# Deployment
DEPLOYMENT_MODE=self-hosted

# Security
INTERNAL_API_SECRET=change-me-in-production
SESSION_SECRET=generate-a-random-64-char-secret-here
JWT_SECRET=generate-a-random-64-char-secret-here
# Seeds for the rotating attendance QR are derived from this, never stored.
ATTENDANCE_SECRET=generate-a-random-64-char-secret-here

# URLs
BACKEND_URL=http://localhost:8013

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Web App (for OAuth redirect)
WEB_APP_URL=http://localhost:3013

# Email (SMTP). Without SMTP_HOST nothing is sent — messages are written to
# the log instead, which keeps local development working without a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=unefy <noreply@example.org>
SMTP_STARTTLS=true

# Debug
DEBUG=true
LOG_LEVEL=DEBUG

# Push (FCM). Off by default — docker compose up must work without a Google
# account. To enable: create a Firebase project, download a service-account
# key, point FCM_CREDENTIALS_FILE at it (the file is a secret: it can send
# push to every device in every club) and set PUSH_ENABLED=true.
PUSH_ENABLED=false
FCM_CREDENTIALS_FILE=
